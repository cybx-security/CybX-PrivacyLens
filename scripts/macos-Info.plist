<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for the PrivacyLens.app double-click launcher; build-all.sh
     substitutes @VERSION@ when assembling the bundle. -->
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>PrivacyLens</string>
	<key>CFBundleDisplayName</key><string>PrivacyLens</string>
	<key>CFBundleIdentifier</key><string>com.cybx.privacylens.gui</string>
	<key>CFBundleExecutable</key><string>PrivacyLens</string>
	<key>CFBundleIconFile</key><string>icon</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleVersion</key><string>@VERSION@</string>
	<key>CFBundleShortVersionString</key><string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key><string>11.0</string>
	<key>NSHighResolutionCapable</key><true/>
</dict>
</plist>
